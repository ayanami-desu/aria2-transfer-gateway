PUID=1000
PGID=1000
ARIA2_RPC_SECRET=replace-with-a-long-random-secret
GATEWAY_API_TOKEN=replace-with-a-different-long-random-secret

# 可选覆盖项；未设置时使用 config.yaml 中的值。
GATEWAY_LISTEN_ADDR=0.0.0.0:8787
ARIA2_RPC_ENDPOINT=http://127.0.0.1:6800/jsonrpc
GATEWAY_CORS_ORIGINS=http://127.0.0.1:6880,http://localhost:6880

# 宿主机持久化目录；Compose 会分别挂载到容器内的 /config、/downloads、/data 和 /rclone。
ARIA2_CONFIG_DIR=./runtime/aria2/config
ARIA2_DOWNLOAD_DIR=./runtime/aria2/downloads
GATEWAY_DATA_DIR=./runtime/gateway
RCLONE_CONFIG_DIR=./runtime/rclone
# rclone 配置文件的容器内路径；未单独指定目的地配置时使用此文件。
RCLONE_CONFIG=/rclone/rclone.conf
